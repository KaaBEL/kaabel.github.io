  "xmlTools.xmlFormatterImplementation": "classic",
  "svgeditor.defaultUnit": "px",
  "files.associations": {
    "*.txt": "plaintext",
    "*.dbv": "json",
    "*.dbvt": "PNG", // LOL
  },
  "liveshare.connectionMode": "relay",
  "githubIssues.queries": [
    {
      "label": "My Issues",
      "query": "default"
    },
    {
      "label": "Created Issues",
      "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
    },
    {
      "label": "Recent Issues",
      "query": "state:open repo:${owner}/${repository} sort:updated-desc"
    }
  ],
  "svg.preview.mode": "svg",
  "githubPullRequests.remotes": [
    "origin",
    "upstream",
    "Dr keys"
  ],
  "[python]": {
    "editor.formatOnType": true
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.NoBrowser": true,
  "liveServer.settings.wait": 65535000,
  "workbench.startupEditor": "none",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "workbench.editor.showTabs": false,
  "liveServer.settings.multiRootWorkspaceName": "${dirname}",
  "diffEditor.maxComputationTime": 0,
  "liveServer.settings.port": 5500,
  "outline.collapseItems": "alwaysCollapse",
  "merge-conflict.diffViewPosition": "Beside",
  "diffEditor.experimental.showMoves": true,
  "git.confirmSync": false,
  "outline.showVariables": false,
  "outline.showStrings": false,
  "outline.showProperties": false,
  "[markdown]": {
    "outline.showStrings": true
  },
  "emmet.showSuggestionsAsSnippets": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.folding": false,
  "typescript.updateImportsOnFileMove.enabled": "never",
  "window.commandCenter": false,
  "githubPullRequests.pullBranch": "never",
  "livePreview.portNumber": 5500,
  "window.menuBarVisibility": "compact",
  "livePreview.autoRefreshPreview": "Never",
  "workbench.activityBar.visible": false
}
/** Keyboard shortcuts
 * Aka how to be BLAZINGLY FAST! https://www.youtube.com/watch?v=1M9hPXg-bFM
 * (unfortunately uses Slovak keyboard layout xP http://kbdlayout.info/KBDSL/overview+virtualkeys?arrangement=ISO105)
 * Ctrl+d → select next occured selection
 * Ctrl+U go to previous selection
 * Tab / Ctrl+ú / Shift+Tab / Ctrl+ä → (un)indent selected lines
 * Ctrl+Tab → alternative to write a Tab (I never use tabs.)
 * F2 → rename symbol (if its part is selected it stays selected in there)
 * Ctrl+= → single-line comment selectd lines
 * Ctrl+/ → SINGLE-LINE COMMENT SELECTD LINES
 * Ctrl+Shitf+/ → MULTI-LINE COMMENT SELECTD LINES
 * Ctrl+click_at_symbol / F12 → goes to definition or gets its references
 * Alt+ArrowUp / Alt+ArrowDown → move line up/down (MOVING VIEW WITH KEYS)
 * Shift+Alt+ArrowUp / ShiftAlt+ArrowDown → copy line up down (fast scroll)
 * Alt+mouse_select → add selection / mulit selecting
 * Shift+Alt+mouse_select → multi selection rectangle
 * Ctrl+R → Go to Symbol in Editor
 * Ctrl+T → Go to Symbol in Workspace
 * Ctrl+ArrowUp / Ctrl+ArrowDown → move view without cursor
 * Ctrl+Shift+ArrowUp / Ctrl+ArrowDown → move view without cursor
 * Alt+CapsLock CapsLock → to Uppercase
 * Shift+CapsLock CapsLock → to Lowercase
 * Ctrl+Shift+i → inspect tokens ~~Alt+i~~
 * 
 * Alt+o s → open saved file for comparsion ~~setting.json~~
 * Alt+o k → keybindings.json
 * Alt+o c → open another for comparsion
 * Alt+o Enter → open keyoboard shortcut preferences
 * Ctr+, → open Settings
 * Ctr+Shitf+, → open Settings JSON
 * ~~the rest is in Alt+o k~~
 * ~~Alt+e s → open SVG editor~~
 * Alt+2 6 → "→"
 * 
 * Ctrl+W → CLOSES EDITOR
 * Ctrl+Shift+T → REOPENS LAST CLOSED EDITOR
 * Ctrl+E → open recent editor
 * Ctrl+PageUp / Ctrl+PageDown → NEXT/PREVIOUS TAB (go to ↑/↓ open editors)
 * Ctrl+B → toggle side bar
 * Ctrl+Q → open view (makes activity bar Alt+b completely negligable)
 * Alt+B → toggle activity bar
 * Ctrl+Shift+PageUp / Ctrl+Shift+PageDown → move editor up/down
 *   when "open editors" tab is focused
 * Ctrl+Shift+e → Explorere side bar, Ctrl+Shift+e again
 *   focuses back to editor
 * Ctrl+Shift+f → Search side bar
 * Ctrl+Shift+g → (Git) Source Controll side bar
 * Ctrl+Shift+d → Debugger siide bar
 * Ctrl+Shift+x → Extensions side bar
 * Ctrl+Shift+v → Live Share side bar (not live server)
 * Ctrl+Shift+p ... G i t H u b Enter → GitHub side bar
 * (CAPS DESCRIPTIONS ARE FOR BROWSER AND WINDOWS GENERIC KEYBINDS) **/
