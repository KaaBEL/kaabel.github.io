{
  "json.maxItemsComputed": 10000,
  "debug.javascript.autoAttachFilter": "disabled",
  "eslint.options": {
    // .../Code/User/.eslintrc.json
    "configFile": "./.eslintrc.json"
  },
  /*editor 1*/
  "editor.tabSize": 2,
  "editor.maxTokenizationLineLength": 16383, //? idk whats that for
  "editor.autoClosingBrackets": "languageDefined",
  "editor.guides.bracketPairs": "active",
  //? idk whats that for"editor.guides.highlightActiveBracketPair": true, 
  "editor.bracketPairColorization.enabled": false,
  "workbench.colorCustomizations": {
    "editorBracketPairGuide.activeBackground1": "#6f6f6f",
    "editorBracketPairGuide.background1": "#404040",
    "editorBracketPairGuide.activeBackground2": "#6f6f6f",
    "editorBracketPairGuide.background2": "#404040",
    "editorBracketPairGuide.activeBackground3": "#6f6f6f",
    "editorBracketPairGuide.background3": "#404040",
    "editorBracketPairGuide.activeBackground4": "#6f6f6f",
    "editorBracketPairGuide.background4": "#404040",
    "editorBracketPairGuide.activeBackground5": "#6f6f6f",
    "editorBracketPairGuide.background5": "#404040",
    "editorBracketPairGuide.activeBackground6": "#6f6f6f",
    "editorBracketPairGuide.background6": "#404040",
    "statusBar.background" : "#0069af",
  },/**/
  "editor.semanticTokenColorCustomizations": {
    "[*Dark*]": {
      "rules": {
        "variables": {
        },
        "*.documentation": {}
      },
    }
  },
